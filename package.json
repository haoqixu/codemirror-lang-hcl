{
  "name": "codemirror-lang-hcl",
  "version": "0.2.0",
  "description": "HCL language support for CodeMirror",
  "keywords": [
    "codemirror",
    "hcl",
    "lezer",
    "terraform"
  ],
  "scripts": {
    "build": "rollup -c",
    "pretest": "pnpm run build",
    "test": "mocha test/test.js",
    "prepare": "pnpm run build"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haoqixu/codemirror-lang-hcl.git"
  },
  "bugs": {
    "url": "https://github.com/haoqixu/codemirror-lang-hcl/issues"
  },
  "homepage": "https://github.com/haoqixu/codemirror-lang-hcl#readme",
  "dependencies": {
    "@codemirror/language": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.0.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.0.0",
    "mocha": "^9.0.1",
    "rollup": "^2.60.2",
    "rollup-plugin-dts": "^4.0.1",
    "rollup-plugin-ts": "^3.0.2",
    "typescript": "^4.3.4"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.9"
}
